# ============================================================
# ResponseLink OS™ — Environment Variables Template
# .env.example
#
# ResponseLink OS™
# AI-Assisted Community Welfare & Mobile Response Platform
# Powered by 4P3X Intelligent AI™ Created by Kyzel Kreates™
#
# Run 10 — Supabase Auth + Realtime Wiring
#
# ⚠ 4P3X API Config Guard™ — KEY SAFETY RULES:
#   ✓ VITE_ prefixed vars are safe for frontend/browser
#   ✓ Supabase ANON (public) key is safe for frontend
#   ⛔ NEVER add service role keys, JWT secrets, database URLs,
#      private keys, webhook secrets, or admin tokens here
#   ⛔ DO NOT commit .env.local (real values) to git
#   ⛔ NEVER place SUPABASE_SERVICE_ROLE_KEY in frontend code
#
# ⚠ BACKEND-ONLY SECRETS — NEVER IN FRONTEND ENV FILES:
#   SUPABASE_SERVICE_ROLE_KEY  ← server-side only, NEVER frontend
#   OPENAI_API_KEY             ← server-side only
#   GROQ_API_KEY               ← server-side only
#   STRIPE_SECRET_KEY          ← server-side only
#   DATABASE_URL               ← server-side only
#   JWT_SECRET                 ← server-side only
#   PRIVATE_KEY                ← server-side only
#   WEBHOOK_SECRET             ← server-side only
#   ADMIN_TOKEN                ← server-side only
#
# SETUP:
#   1. Copy this file to .env.local
#   2. Fill in your values (see Supabase project → Settings → API)
#   3. Never commit .env.local to version control
#   4. Add .env.local to .gitignore
#
# APP MODES:
#   Demo Mode  — Works without any backend config. Sample data only.
#   Live Mode  — Requires VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY.
#
# "Demo Mode shows the product. Live Mode runs the product."
# ============================================================


# ── Required for Live Mode ────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ── Optional: Override API mode ───────────────────────────────
# Options: demo | live
# If not set, app starts in Demo Mode by default.
# VITE_API_MODE=demo


# ── Optional: App metadata ────────────────────────────────────
# VITE_APP_NAME=ResponseLink OS™
# VITE_APP_VERSION=1.0.0


# ─────────────────────────────────────────────────────────────
# ⛔ NEVER ADD BELOW THIS LINE IN FRONTEND ENV FILES ⛔
#
# SUPABASE_SERVICE_ROLE_KEY=   ← This bypasses ALL RLS — NEVER in frontend
# OPENAI_API_KEY=              ← AI provider secret — server-side only
# GROQ_API_KEY=                ← AI provider secret — server-side only
# STRIPE_SECRET_KEY=           ← Payment secret — server-side only
# DATABASE_URL=                ← Direct DB — server-side only
# JWT_SECRET=                  ← Token signing — server-side only
# PRIVATE_KEY=                 ← Cryptographic secret — server-side only
# WEBHOOK_SECRET=              ← Webhook validation — server-side only
# ADMIN_TOKEN=                 ← Admin access — server-side only
#
# ResponseLink OS™ · 4P3X API Config Guard™
# Created by Kyzel Kreates™
# ─────────────────────────────────────────────────────────────
