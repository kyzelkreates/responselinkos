# ==============================================================
# ResponseLink OS™ — Environment Variables Template
# AI-Assisted Community Welfare & Mobile Response Platform
# Powered by 4P3X Intelligent AI™ Created by Kyzel Kreates™
#
# Run 9 — Backend-Ready Live Mode, API Config, Final MVP
#
# ⚠ SAFE VARIABLES ONLY — DO NOT ADD SECRETS BELOW THIS LINE
#
# 4P3X API Config Guard™ Rules:
#   ✓ VITE_ prefixed vars are safe for frontend/browser
#   ✓ Public anon keys are safe for frontend
#   ⛔ NEVER add service role keys, JWT secrets, database URLs,
#      private keys, webhook secrets, or admin tokens here
#   ⛔ DO NOT commit .env.local (real values) to git
#
# Usage:
#   1. Copy this file to .env.local
#   2. Fill in your values (see notes below)
#   3. Never commit .env.local to version control
#   4. Add .env.local to your .gitignore
# ==============================================================


# ── Backend Provider ──────────────────────────────────────────
# Options: supabase | firebase | aws | rest | local
# Default: local (demo mode — no backend required)
VITE_BACKEND_PROVIDER=local

# ── API Mode ──────────────────────────────────────────────────
# Options: demo | live
# demo = show simulated records | live = real records only
VITE_API_MODE=demo


# ── Supabase (Recommended Backend) ────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
#
# ✓ SUPABASE_URL      — safe for frontend (public)
# ✓ SUPABASE_ANON_KEY — safe for frontend (public anon key ONLY)
# ⛔ SUPABASE_SERVICE_ROLE_KEY — NEVER IN FRONTEND (server-side only)
# ⛔ POSTGRES DATABASE URL     — NEVER IN FRONTEND (server-side only)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ── Firebase (Future Optional Provider) ───────────────────────
# ✓ FIREBASE_API_KEY, AUTH_DOMAIN, PROJECT_ID, APP_ID — public/safe
# ⛔ Firebase Admin SDK keys — NEVER IN FRONTEND

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=


# ── Generic REST / Custom API (Future Optional Provider) ──────
# ✓ Public REST API base URL — safe for frontend
# ✓ Public client token (pk_ prefix convention) — safe for frontend
# ⛔ Server-side admin tokens — NEVER IN FRONTEND

VITE_PUBLIC_API_BASE_URL=
VITE_PUBLIC_CLIENT_TOKEN=


# ── Map Provider (Optional) ───────────────────────────────────
# Public map API keys (e.g. MapTiler, Mapbox public token)
# ✓ Mapbox public token (pk. prefix) — safe for frontend
# ⛔ Mapbox secret token (sk. prefix) — NEVER IN FRONTEND

VITE_MAPTILER_API_KEY=
VITE_MAPBOX_TOKEN=


# ── DO NOT ADD BELOW THIS LINE ────────────────────────────────
#
# ⛔ SUPABASE_SERVICE_ROLE_KEY= (server-side only — never frontend)
# ⛔ OPENAI_API_KEY=            (server-side only — never frontend)
# ⛔ GROQ_API_KEY=              (server-side only — never frontend)
# ⛔ STRIPE_SECRET_KEY=         (server-side only — never frontend)
# ⛔ DATABASE_URL=              (server-side only — never frontend)
# ⛔ JWT_SECRET=                (server-side only — never frontend)
# ⛔ PRIVATE_KEY=               (server-side only — never frontend)
# ⛔ WEBHOOK_SECRET=            (server-side only — never frontend)
# ⛔ ADMIN_TOKEN=               (server-side only — never frontend)
#
# ResponseLink OS™ · 4P3X API Config Guard™
# Created by Kyzel Kreates™
# ==============================================================
